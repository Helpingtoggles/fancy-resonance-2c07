# Copy to .env and set real values before `docker compose up`.

# REQUIRED: JWT signing key. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HHRN_SECRET_KEY=

# PostgreSQL password (defaults to 'hhrn' for local development only)
POSTGRES_PASSWORD=

# OCR engine: tesseract (default in Docker) or stub (dev/tests)
HHRN_OCR_ENGINE=tesseract

# NOTE: The safety invariants (no auto-submit, no auto-sign, no AI final OASIS
# codes) are hard-coded. Setting HHRN_ALLOW_AUTO_SIGN or similar to true makes
# the application REFUSE TO START — they exist only for visibility.
